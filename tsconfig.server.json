{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "composite": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "middleware.ts",
    "api/**/*.ts",
    "db/**/*.ts",
    "scripts/**/*.ts",
    "src/domain/forecast.ts",
    "src/domain/playerMap.ts",
    "src/domain/playerSignals.ts",
    "src/domain/communitySignals.ts",
    "src/domain/cardMarket.ts",
    "src/domain/binderGraduationIndex.ts",
    "src/domain/binderGraduationIndexV2.ts",
    "src/domain/binderScore.ts",
    "src/domain/magnificentX.ts",
    "src/domain/hobbyMasterRanking.ts",
    "src/domain/hobbyBreakoutSignal.ts",
    "src/domain/hobbySalesTrend.ts",
    "src/domain/hobbyLiquidationSignal.ts",
    "src/domain/hobbyPlayerRanking.ts",
    "src/domain/hobbyPlayerRankingV1.ts",
    "src/domain/hobbyDecisionDesk.ts",
    "src/domain/itFactor.ts",
    "src/domain/playerMobilityContext.ts",
    "src/domain/subjectSearch.ts",
    "src/domain/playerHandling.ts",
    "src/football/marketFeedContract.ts"
  ],
  "exclude": ["**/* 2.ts", "**/* 2.tsx"]
}
