      "const": "hobby-player-rankings.v2"
    },
    "contractVersion": {
      "const": "hobby-player-rankings-contract/v2"
    },
    "modelVersion": {
      "const": "hobby-player-durable-signal/18m-robust-core-v2.0.0"
    },
    "snapshot": {
      "$ref": "#/$defs/snapshot"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "screenSummary": {
      "$ref": "#/$defs/screenSummary"
    },
    "cohorts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/cohort"
      },
