                "contains": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "const": "hashtag_basketball"
                    }
                  },
                  "required": [
                    "id"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              }
            }
          }
        }
      }
