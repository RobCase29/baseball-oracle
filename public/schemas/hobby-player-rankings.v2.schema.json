  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractVersion",
    "modelVersion",
    "snapshot",
    "items",
    "scope",
    "screenSummary",
    "cohorts",
    "page",
    "meta"
  ],
  "properties": {
