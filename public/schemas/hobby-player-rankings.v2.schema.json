{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baseball-oracle.vercel.app/schemas/hobby-player-rankings.v2.schema.json",
  "title": "Hobby Oracle Player Rankings v2",
  "description": "Research-only, single-sport active-growth signals combining forward-looking dynasty consensus with subject-level completed-sales durability. Input-integrity confidence is capped at 75 and investment confidence is explicitly withheld. The contract does not publish expected returns, portfolio actions, or exact-card recommendations.",
