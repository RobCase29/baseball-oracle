              "sport": {
                "const": "football"
              }
            },
            "required": [
              "sport"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "sport": {
                "const": "basketball"
              }
            },
            "required": [
              "sport"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "page": {
      "$ref": "#/$defs/page"
    },
    "meta": {
      "$ref": "#/$defs/meta"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "properties": {
              "sport": {
                "const": "football"
              }
